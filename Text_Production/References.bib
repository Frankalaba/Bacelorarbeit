@article{smithAgriculturalMethaneEmissions2021,
  title = {Agricultural Methane Emissions and the Potential Formitigation},
  author = {Smith, Pete and Reay, Dave and Smith, Jo},
  date = {2021-09-27},
  journaltitle = {Philosophical Transactions of the Royal Society A: Mathematical, Physical and Engineering Sciences},
  shortjournal = {Philos. Trans. R. Soc. Math. Phys. Eng. Sci.},
  volume = {379},
  number = {2210},
  pages = {20200451},
  issn = {1364-503X},
  doi = {10.1098/rsta.2020.0451},
  url = {https://doi.org/10.1098/rsta.2020.0451},
  urldate = {2026-08-27},
  abstract = {Agriculture is the largest anthropogenic source of methane (CH4), emitting 145\,Tg\,CH4\,y−1 to the atmosphere in 2017. The main sources are enteric fermentation, manure management, rice cultivation and residue burning. There is significant potential to reduce CH4 from these sources, with bottom-up mitigation potentials of approximately 10.6, 10, 2 and 1\,Tg\,CH4\,y−1 from rice management, enteric fermentation, manure management and residue burning. Other system-wide studies have assumed even higher potentials of 4.8–47.2\,Tg\,CH4\,y−1 from reduced enteric fermentation, and 4–36\,Tg\,CH4\,y−1 from improved rice management. Biogas (a methane-rich gas mixture generated from the anaerobic decomposition of organic matter and used for energy) also has the potential to reduce unabated CH4 emissions from animal manures and human waste. In addition to these supply side measures, interventions on the demand-side (shift to a plant-based diet and a reduction in total food loss and waste by 2050) would also significantly reduce methane emissions, perhaps in the order of greater than 50\,Tg\,CH4\,y−1. While there is a pressing need to reduce emissions of long-lived greenhouse gases (CO2 and N2O) due to their persistence in the atmosphere, despite CH4 being a short-lived greenhouse gas, the urgency of reducing warming means we must reduce any GHG emissions we can as soon as possible. Because of this, mitigation actions should focus on reducing emissions of all the three main anthropogenic greenhouse gases, including CH4.This article is part of a discussion meeting issue 'Rising methane: is warming feeding warming? (part1)'.},
  file = {/home/linusb/Dokumente/Zotero_Speicher_bibliographie/storage/CSR78XKT/Smith et al. - 2021 - Agricultural methane emissions and the potential formitigation.pdf;/home/linusb/Dokumente/Zotero_Speicher_bibliographie/storage/6P2NW2Y9/rsta.2020.html}
}

@article{songControlMethaneEmission2010,
  title = {Control of {{Methane Emission}} in {{Ruminants}} and {{Industrial Application}} of {{Biogas}} from {{Livestock Manure}} in {{Korea}}},
  author = {Song, Man K. and Li, Xiang Z. and Oh, Young K. and Lee, Chang-kyu and Hyun, Y.},
  date = {2010-12-21},
  journaltitle = {Asian-Australasian Journal of Animal Sciences},
  shortjournal = {Asian-Australas. J. Anim. Sci.},
  volume = {24},
  number = {1},
  pages = {130--136},
  issn = {1011-2367, 1976-5517},
  doi = {10.5713/ajas.2011.r.02},
  url = {http://ajas.info/journal/view.php?doi=10.5713/ajas.2011.r.02},
  urldate = {2026-07-22},
  abstract = {Das ist ein Übersichtsartikel von Song et al. (2011, Asian-Australasian Journal of Animal Sciences 24(1):130–136) über Methan-Kontrolle bei Wiederkäuern in Korea und die industrielle Biogasnutzung. Hier die Kernpunkte: Hintergrund Methan gilt als bedeutendes Treibhausgas mit ca. 21-facher Klimawirkung von CO₂; die Landwirtschaft trägt global schätzungsweise 18 \% zu den THG-Emissionen bei. Methan entsteht bei der Pansenfermentation durch methanogene Archaeen, die Wasserstoff (H₂) zu CH₄ umsetzen – ein Energieverlust von 2–15 \% der aufgenommenen Bruttoenergie. Teil 1: Methan-Kontrolle im Pansen Der Artikel fasst mehrere südkoreanische In-vitro-Studien zu verschiedenen Ansätzen zusammen, die alle auf demselben Prinzip beruhen: dem Wasserstoff im Pansen alternative Senken zur Methanogenese anzubieten oder die Methanogene direkt zu hemmen. Direkte Methanogenen-Hemmer: BES (Bromoethansulfonsäure, ein Coenzym-M-Analogon): reduzierte Methanproduktion dosisabhängig; bei 5 mM praktisch vollständige Hemmung, begleitet von einer Reduktion der Methanogenen-Population PMDI (Pyromellitsäure-Diimid) und halogenierte Verbindungen zeigten die stärksten Effekte im Vergleich verschiedener Wirkstoffklassen Propionat-Vorstufen als H₂-Senke: Fumarat und Malat (Dicarbonsäuren im Propionat-Stoffwechselweg) senkten die Methanbildung deutlich – bei 24 mM Fumarat um 65,6 \%, bei Malat um 47,5 \% (12-Stunden-Inkubation) Der Vorteil wird explizit hervorgehoben: gleichzeitige Senkung der CH₄-Produktion und Steigerung der Nettoenergie-Retention – also genau der Mechanismus, den wir in unserer Diskussion durchgespielt haben (H₂ landet in einem vom Tier nutzbaren Molekül statt in CH₄) Ungesättigte Fettsäuren (UFAs) und Öle: Linol- und Linolensäure sowie Lein- und Fischöl senkten die Methanbildung durch Biohydrogenierung, die als konkurrierende H₂-Senke wirkt Kombinationen aus Ölen mit Fumarat/Malat zeigten additive bis synergistische Effekte (bis zu 63 \% Reduktion) Fischöl erhöhte zusätzlich die Propionat-Konzentration, was den H₂-Verbrauch weiter steigerte Praktisches Problem: Der Artikel betont, dass die In-vitro-Erfolge in der Praxis oft nicht konsistent reproduzierbar sind – hauptsächlich wegen mikrobieller Adaptation an die zugesetzten Wirkstoffe über die Zeit. Teil 2: Biogas aus Gülle Der zweite Teil behandelt einen völlig anderen Aspekt: die industrielle Nutzung von Methan aus Tierdung als erneuerbare Energiequelle statt dessen Vermeidung. Geschätzte Methan-Produktionsraten aus Gülle verschiedener Tierarten (Milchvieh, Mastrind, Schwein, Geflügel) Fallbeispiel einer Biogasanlage in Chang Nyung, Korea (seit 2008 in Betrieb, dänische Beratung), mit konkreten Produktionsdaten für Biogas und Stromerzeugung Der Methangehalt im produzierten Biogas lag bei 60–70 \% Der Artikel benennt strukturelle Probleme der koreanischen Biogas-Branche: viele Kleinanlagen mit geringer Kapazität, wirtschaftliche Probleme durch niedrige Einspeisevergütung, mangelndes Betriebs-Know-how Einordnung für dein Thema Für deine Mikrobiom-Engineering-Fragestellung ist besonders der Fumarat/Malat-Teil relevant: Er bestätigt empirisch genau den Mechanismus, den wir diskutiert haben – eine alternative H₂-Senke (hier: Propionat-Weg statt Acetogenese) kann Methan reduzieren und gleichzeitig die Energieausbeute steigern, ohne dass die Fermentation destabilisiert wird. Allerdings ist zu beachten: Das sind reine In-vitro-Batch-Kultur-Daten, keine In-vivo-Tierversuche – die Übertragbarkeit auf reale DE/Ym-Effekte im lebenden Tier (unser eigentliches Rechenproblem) bleibt damit offen, zumal der Artikel selbst auf die mikrobielle Adaptation als Hauptgrund für inkonsistente In-vivo-Ergebnisse hinweist. von claude},
  langid = {english},
  file = {/home/linusb/Dokumente/Zotero_Speicher_bibliographie/storage/CU82NX87/Song et al. - 2010 - Control of Methane Emission in Ruminants and Industrial Application of Biogas from Livestock Manure.pdf}
}

