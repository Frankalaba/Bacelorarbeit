@book{ipccClimateChange20222022,
  title = {Climate {{Change}} 2022 – {{Impacts}}, {{Adaptation}} and {{Vulnerability}}},
  shorttitle = {Climate {{Change}} 2022 – {{Impacts}}, {{Adaptation}} and {{Vulnerability}}},
  author = {{IPCC}},
  editor = {Pörtner, Hans-Otto and Roberts, Debra C. and Tignor, Melinda and Poloczanska, Elvira and Mintenbeck, Katja and Alegría, Andrés and Craig, M. and Langsdorf, S. and Löschke, S. and Möller, V. and Okem, A. and Rama, B.},
