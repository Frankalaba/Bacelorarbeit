@incollection{irfanChapterEightRadiative2024,
  title = {Chapter {{Eight}} - {{Radiative}} Forcing on Climate Change: Assessing the Effect of Greenhouse Gases on Energy Balance of {{Earth}}},
  shorttitle = {Chapter {{Eight}} - {{Radiative}} Forcing on Climate Change},
  booktitle = {Advances and {{Technology Development}} in {{Greenhouse Gases}}:  {{Emission}}, {{Capture}} and {{Conversion}}},
  author = {Irfan, Muhammad and Musarat, Muhammad Ali and Alaloul, Wesam Salah and Ghufran, Maria},
  editor = {Rahimpour, Mohammad Reza and Makarem, Mohammad Amin and Meshksar, Maryam},
  year = 2024,
  month = jan,
  pages = {137--167},
  publisher = {Elsevier},
  doi = {10.1016/B978-0-443-19066-7.00012-6},
  urldate = {2026-08-20},
  abstract = {Humans depend on ecosystems for nourishment, potable water, and a host of additional amenities that are susceptible to climate change. By affecting the water cycle, habitats, animals' living patterns (such as nesting and migration tendencies), and the time frame of natural processes like flower blooming, alterations to the Earth's climate can influence the ecosystems. Changes that disrupt ecosystem function may result from the threat of harm or even extinction for some species. Even though wildfires are naturally occurring, they can significantly disrupt ecosystems, inflict property damage, put people and communities in imminent danger, and impair air quality wherever they occur from the point of origin when they become more dangerous and common. Similarly, due to human activities, greenhouse gases (GHGs) are released into the atmosphere and can significantly alter the balance of nature, if the inflow and outflow of these gases from the atmosphere are not balanced, thus resulting in intense variations in the climate. Moreover, the climate change caused due to human activities can have serious implications for humans that must be managed effectively and without causing any further delay. Therefore the current chapter will comprehensively discuss this balancing and misbalancing in climate change caused due to radiative forcing, a phenomenon in which the amount of energy that enters the Earth's atmosphere and the amount of energy leaving it are different.},
  isbn = {978-0-443-19066-7},
  keywords = {climate change,energy balance,global warming,greenhouse gases,Radiative forcing},
  file = {/home/linusb/Dokumente/Zotero_Speicher_bibliographie/storage/EJNTGCB6/B9780443190667000126.html}
}

@article{johnsonMethaneEmissionsCattle1995,
  title = {Methane Emissions from Cattle},
  author = {Johnson, K. A. and Johnson, D. E.},
  year = 1995,
  month = aug,
  journal = {Journal of Animal Science},
  volume = {73},
  number = {8},
  pages = {2483--2492},
  issn = {0021-8812},
  doi = {10.2527/1995.7382483x},
  abstract = {Increasing atmospheric concentrations of methane have led scientists to examine its sources of origin. Ruminant livestock can produce 250 to 500 L of methane per day. This level of production results in estimates of the contribution by cattle to global warming that may occur in the next 50 to 100 yr to be a little less than 2\%. Many factors influence methane emissions from cattle and include the following: level of feed intake, type of carbohydrate in the diet, feed processing, addition of lipids or ionophores to the diet, and alterations in the ruminal microflora. Manipulation of these factors can reduce methane emissions from cattle. Many techniques exist to quantify methane emissions from individual or groups of animals. Enclosure techniques are precise but require trained animals and may limit animal movement. Isotopic and nonisotopic tracer techniques may also be used effectively. Prediction equations based on fermentation balance or feed characteristics have been used to estimate methane production. These equations are useful, but the assumptions and conditions that must be met for each equation limit their ability to accurately predict methane production. Methane production from groups of animals can be measured by mass balance, micrometeorological, or tracer methods. These techniques can measure methane emissions from animals in either indoor or outdoor enclosures. Use of these techniques and knowledge of the factors that impact methane production can result in the development of mitigation strategies to reduce methane losses by cattle. Implementation of these strategies should result in enhanced animal productivity and decreased contributions by cattle to the atmospheric methane budget.},
  langid = {english},
  pmid = {8567486},
  keywords = {Animal Feed,Animals,Atmosphere,Cattle,Cattle Diseases,Chromatography Gas,Diet,Eating,Eructation,Female,Fermentation,Greenhouse Effect,Mass Spectrometry,Methane,Rumen}
}

