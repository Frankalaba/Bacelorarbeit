@online{capovillaTransformationPlasmidDNA2025,
  title = {Transformation of Plasmid {{DNA}} into {{{\mkbibemph{Prochlorococcus}}}} via Electroporation},
  author = {Capovilla, Giovanna and Castro, Kurt G. and Ziegler, Christine A. and Chisholm, Sallie W.},
  date = {2025-09-21},
  eprinttype = {Molecular Biology},
  doi = {10.1101/2025.09.20.677525},
  url = {http://biorxiv.org/lookup/doi/10.1101/2025.09.20.677525},
  urldate = {2026-08-22},
  abstract = {Abstract                        Prochlorococcus             is the most numerically abundant photosynthetic organism in the oceans and plays a role in global carbon cycling. Despite its ecological significance and the availability of over a thousand assembled genomes, progress in understanding gene function has been limited by the lack of genetic tools. Here, we report a reproducible electroporation-based protocol to introduce replicative plasmids into two strains of             Prochlorococcus             representing different ecotypes: MIT9313 (low-light adapted) and MED4 (high-light adapted). Using plasmids carrying a spectinomycin resistance cassette, we achieved transformation in \textasciitilde 33\% of MED4 and \textasciitilde 10\% of MIT9313 attempts, with greatest success when electroporating cells in late exponential phase. Transformed cells stably retained plasmids and expressed resistance genes, demonstrating functional uptake and gene expression. We also delivered a modified 13 kb plasmid carrying a CRISPR-Cpf1 system into MED4. While no targeted edits were observed,             cpf1             and             specR             were expressed, indicating successful delivery of large constructs and active transcription. These findings represent a key step toward genetic manipulation of             Prochlorococcus             , enabling future optimization of gene editing approaches and deeper functional analysis of its vast and largely uncharacterized pangenome.},
  langid = {english},
  pubstate = {prepublished},
  file = {/home/linusb/Dokumente/Zotero_Speicher_bibliographie/storage/T5VY2NNH/Capovilla et al. - 2025 - Transformation of plasmid DNA into Prochlorococcus via electroporation.pdf}
}

